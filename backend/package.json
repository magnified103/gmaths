{
  "name": "backend",
  "version": "1.0.0",
  "description": "GMATHS backend server with Fastify + TypeScript",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "keywords": [
    "fastify",
    "typescript",
    "gmaths",
    "education"
  ],
  "author": "GMATHS Education",
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.8.2",
    "bcrypt": "^6.0.0",
    "fastify": "^5.3.3",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.8.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.24",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
