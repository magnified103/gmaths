{
  "name": "backend",
  "version": "1.0.0",
  "description": "GMATHS backend server with Fastify + TypeScript",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --runInBand --watch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:seed:prod": "node -r ts-node/register prisma/seed/index.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "fastify",
    "typescript",
    "gmaths",
    "education"
  ],
  "author": "GMATHS Education",
  "license": "ISC",
  "packageManager": "pnpm@10.18.1",
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/error": "^4.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "^6.16.3",
    "@types/redis": "^4.0.11",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^5.0.3",
    "http-status-codes": "^2.3.0",
    "json-schema-to-ts": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.16.3",
    "redis": "^5.8.3",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.24",
    "form-auto-content": "^3.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prismock": "^1.35.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
