# GMATHS Production Environment Configuration
# Copy this file to .env in the backend directory and update with actual values

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/gmaths_production"

# JWT Configuration  
JWT_SECRET="your-super-secure-jwt-secret-key-here-at-least-32-characters"
JWT_EXPIRES_IN="24h"

# Redis Configuration (for session management and WebSocket scaling)
REDIS_URL="redis://localhost:6379"

# Application Configuration
NODE_ENV="production"
PORT="3000"

# AWS Configuration (if using AWS services)
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"

# Email Configuration (AWS SES for sending verification emails)
EMAIL_FROM="noreply@gmaths.edu.vn"
EMAIL_REGION="ap-southeast-1"

# Security Configuration
CORS_ORIGIN="https://gmaths.edu.vn"
SECURE_COOKIES="true"

# Session Configuration
SESSION_SECRET="your-session-secret-key-here"
COOKIE_DOMAIN="gmaths.edu.vn"

# File Upload Configuration
MAX_FILE_SIZE="10mb"
UPLOAD_PATH="/var/www/gmaths/uploads"

# Logging Configuration
LOG_LEVEL="info"
LOG_FILE="/var/log/gmaths/application.log"

# Rate Limiting
RATE_LIMIT_WINDOW="15" # minutes
RATE_LIMIT_MAX_REQUESTS="100"

# Performance Configuration (for t2.small optimization)
NODE_OPTIONS="--max-old-space-size=512"
UV_THREADPOOL_SIZE="4" 