# GMATHS Education Website - Production Environment Variables
# Copy this to backend/.env and frontend/.env.production and update values

# ===========================================
# BACKEND ENVIRONMENT VARIABLES
# ===========================================

# Database Configuration
DATABASE_URL="postgresql://gmaths_user:secure_production_password_change_this@localhost:5432/gmaths_production"

# JWT Configuration
JWT_SECRET="your_very_secure_jwt_secret_change_this_in_production"
JWT_EXPIRES_IN="7d"

# Server Configuration
NODE_ENV="production"
PORT=3000
HOST="0.0.0.0"

# CORS Configuration
CORS_ORIGIN="https://yourdomain.com"

# Redis Configuration (if using Redis)
REDIS_URL="redis://localhost:6379"

# Email Configuration (if implemented)
SMTP_HOST="your-smtp-host"
SMTP_PORT=587
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
FROM_EMAIL="noreply@yourdomain.com"

# File Upload Configuration
MAX_FILE_SIZE="10485760"  # 10MB in bytes
UPLOAD_DIR="/var/www/gmaths/uploads"

# ===========================================
# FRONTEND ENVIRONMENT VARIABLES  
# ===========================================

# API Configuration
VITE_API_URL="https://yourdomain.com/api"

# WebSocket Configuration
VITE_WS_URL="wss://yourdomain.com"

# Application Configuration
VITE_APP_NAME="GMATHS Education Platform"
VITE_APP_VERSION="1.0.0"

# Feature Flags
VITE_ENABLE_ANALYTICS="false"
VITE_ENABLE_DEBUG="false" 